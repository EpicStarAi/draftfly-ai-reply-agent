modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0", "stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
APP_BASE_URL = "https://sales-reply-ai.replit.app"
ALLOWED_TELEGRAM_USER_IDS = "798537475,7369372055"
EPICGRAM_API_KEY = "0511f8f802708a741afd8dd8e281fb1ab25f5665b900e54077693672349785d9"
