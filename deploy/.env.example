# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Domain the app is served from (Caddy obtains a Let's Encrypt cert for it)
DOMAIN=draftfly.example.com
# Public base URL — used for Slack OAuth redirect_uri and Stripe webhook registration
APP_BASE_URL=https://draftfly.example.com

# Postgres password for the bundled db service (DATABASE_URL is derived in docker-compose.yml)
POSTGRES_PASSWORD=change-me

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# Slack app credentials (api.slack.com/apps -> Basic Information)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Restrict operator login to this workspace (Team ID, e.g. T0123456789)
SLACK_TEAM_ID=
SLACK_APP_ID=
# Optional channel for error alerts
#SLACK_ALERT_CHANNEL=

# Claude API key for draft generation
ANTHROPIC_API_KEY=

# Lemlist
LEMLIST_API_KEY=
# Shared secret checked on X-Webhook-Secret header of incoming Lemlist webhooks
LEMLIST_WEBHOOK_SECRET=

# Stripe (optional — billing disabled if unset)
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=

# Telegram mini-app auth (optional)
#TELEGRAM_BOT_TOKEN=
#ALLOWED_TELEGRAM_USER_IDS=

LOG_LEVEL=info
